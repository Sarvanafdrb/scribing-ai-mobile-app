# Point directly at the Scribing AI backend (no Next.js proxy on mobile)
# Use localhost when testing Expo web on this PC.
# Use your LAN IP when testing on a physical phone (see README).
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_UPLOADS_BASE_URL=http://localhost:5000
EXPO_PUBLIC_APP_NAME=Scribing AI

# Optional overrides for Expo web (otherwise LAN IPs auto-map to localhost)
# EXPO_PUBLIC_WEB_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_WEB_UPLOADS_BASE_URL=http://localhost:5000

# Production example:
# EXPO_PUBLIC_API_URL=https://scribing-ai-api.onrender.com/api
# EXPO_PUBLIC_UPLOADS_BASE_URL=https://scribing-ai-api.onrender.com
